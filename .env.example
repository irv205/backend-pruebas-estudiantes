# ──────────────────────────────────────────────────────────────
# Plantilla de entorno — Etapa 1 (desarrollo local)
# 1) cp .env.example .env
# 2) Ajusta valores si lo necesitas. NUNCA versiones .env.
# Estos valores son SOLO de ejemplo para desarrollo local.
# ──────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
# Puerto publicado en el HOST por Docker (el contenedor siempre escucha en 3000).
# En este entorno el 3000 está ocupado por otro proyecto: se publica 3100.
# IMPORTANTE: PUBLIC_BASE_URL debe usar el MISMO puerto que APP_HOST_PORT.
APP_HOST_PORT=3100

# PostgreSQL (servicio docker "postgres", sin puerto publicado al host)
POSTGRES_USER=practicas
POSTGRES_PASSWORD=dev_password_change_me
POSTGRES_DB=practicas
# La API corre dentro de la red de compose → host "postgres".
# Si ejecutas la API fuera de Docker, cambia el host a 127.0.0.1 y publica el puerto.
DATABASE_URL=postgresql://practicas:dev_password_change_me@postgres:5432/practicas?schema=public

# JWT — SOLO placeholders de desarrollo (mínimo 32 caracteres).
# Genera valores propios y DOBLEMENTE aleatorios antes de cualquier despliegue.
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_dev_only_0123456789
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_dev_only_9876543210
# Duración del token de acceso (sufijos s/m/h/d). El refresh se guarda revocable en PostgreSQL.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# CORS: "*" o lista separada por comas (p. ej. http://localhost:5173,http://localhost:4200)
CORS_ORIGIN=*

# SMTP interno (Mailpit). UI de correos de prueba: http://127.0.0.1:8025 (solo host, no estudiantes)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=Backend Prácticas <no-reply@practicas.local>
# API interna de Mailpit para el portal (opcional; por defecto http://mailpit:8025/api/v1).
# NUNCA expongas la UI de Mailpit a estudiantes: el portal consulta solo /api/v1/mail/me.
# MAILPIT_API_URL=http://mailpit:8025/api/v1

# Fallback de URL base para enlaces de correos, manifiesto del portal y Swagger.
# El CÓDIGO AÑADE /api/v1: escribe solo la raíz, SIN el sufijo.
# Local: PUBLIC_BASE_URL=http://localhost:3100 (mismo puerto que APP_HOST_PORT).
# Con Cloudflare Tunnel NO hace falta editarlo: el túnel escribe la URL vigente
# en run/tunnel-url.txt y la app la prefiere en runtime (sin reiniciar).
PUBLIC_BASE_URL=http://localhost:3100

# ── URL pública opcional con Cloudflare Tunnel (quick tunnel) ──────────────
# `./start.sh` pregunta al final del arranque (solo en terminal interactiva) si
# quieres abrir el túnel. Si aceptas, invoca scripts/start-with-public-url.mjs
# con --tunnel-only y PORT=$APP_HOST_PORT. Si respondes N (o no hay TTY), ábrelo
# después con: cloudflared tunnel --url http://127.0.0.1:$APP_HOST_PORT
# El script hace un quick tunnel ANÓNIMO: `cloudflared tunnel --url http://127.0.0.1:$PORT`.
# No usa tokens, cuenta de Cloudflare ni archivo de config: la URL aleatoria se
# imprime en la terminal (sin /api/v1; cambia en cada ejecución).
# Propagación automática: el script escribe `run/tunnel-url.txt` (TEXTO PLANO con
# la URL raíz en una sola línea, sin /api/v1) y la app lo relee en cada uso.
# `run/` es LOCAL y EFÍMERO (ignorado por Git y montado solo lectura en Docker);
# se borra al cerrar el túnel. Si el archivo no existe o no es válido, la app
# usa exactamente PUBLIC_BASE_URL (raíz, sin /api/v1).
#   PUBLIC_URL_FILE=./run/tunnel-url.txt  Ruta del archivo (relativa al cwd;
#                                         dentro de Docker es /app/run/...);
#                                         el default ya es esa ruta.
#   PUBLIC_URL_FILE_DISABLED=true         Ignora el archivo (por ejemplo en e2e;
#                                         NODE_ENV=test ya lo ignora por defecto).
# Todas estas variables son OPCIONALES y van aquí como COMENTARIOS (sin secretos).
#   PUBLIC_URL_AUTO=1          Genera el túnel sin preguntar (= npm run start:public).
#   CLOUDFLARE_TUNNEL_AUTO=1   Alias de PUBLIC_URL_AUTO.
#   START_WITH_PUBLIC_URL=1    Otro alias que reconoce el script.
#   SKIP_PUBLIC_URL=1          No crea túnel ni pregunta (alias: NO_PUBLIC_URL=1, PUBLIC_URL=0).
#   SKIP_TUNNEL_PROMPT=1       No ofrece ni abre el túnel desde ./start.sh (p. ej. en CI):
#                              no se hace la pregunta y se muestra el comando manual.
#   SKIP_PUBLIC_URL_PROMPT=1   Alias de SKIP_TUNNEL_PROMPT (mismo efecto: sin túnel).
#   TUNNEL_ONLY=1              Equivalente interno de --tunnel-only: ./start.sh lo usa
#                              al invocar scripts/start-with-public-url.mjs --tunnel-only.
#                              El profesor NO necesita configurarlo manualmente.
#   READY_TIMEOUT_MS=60000     Espera máxima a /health/ready en el modo directo del script.
#   FORCE_BUILD=1              Fuerza `npm run build` antes de arrancar.
#   SKIP_BUILD=1               Omite la compilación (requiere dist/main.js).
# PORT (definido arriba, 3000) es el puerto del backend EN EL HOST en el modo
# directo; NO es APP_HOST_PORT (puerto que Docker publica, 3100). `./start.sh`
# ya invoca el túnel con PORT=$APP_HOST_PORT, apuntando a la API real.

# Espacios
DEMO_SPACE_SLUG=demo-publico
SANDBOX_TTL_HOURS=72
SANDBOX_PRODUCT_QUOTA=100

# ── Etapa 2: archivos / S3 (MinIO) ─────────────────────────────────────────
# Por defecto se usa almacenamiento LOCAL (./storage/uploads; volumen files_data
# en Docker). Para usar MinIO: FILES_STORAGE=s3 y descomenta el servicio en
# docker-compose.yml (ver README). NINGÚN secreto real en este archivo.
FILES_STORAGE=local
FILES_LOCAL_DIR=./storage/uploads
FILE_MAX_SIZE_BYTES=5242880
FILE_ALLOWED_MIME_TYPES=image/png,image/jpeg,image/gif,image/webp,application/pdf,text/plain
SPACE_FILE_QUOTA_BYTES=104857600
SPACE_FILE_QUOTA_COUNT=50

# Servidor → S3 (red interna de Compose). Solo se usa si FILES_STORAGE=s3.
# S3_ENDPOINT=http://minio:9000
# S3_REGION=us-east-1
# S3_BUCKET=practicas
# S3_ACCESS_KEY=CHANGE_ME_s3_access_key
# S3_SECRET_KEY=CHANGE_ME_s3_secret_key
# S3_FORCE_PATH_STYLE=true
# Endpoint público para firmar URLs que consumirá el navegador/móvil.
# Si se omite, las descargas se sirven SIEMPRE a través de la API.
# S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
# S3_PRESIGN=false
# S3_PRESIGN_TTL_SECONDS=300

# ── Etapa 2: simulador de escenarios (topes duros) ──────────────────────────
SCENARIO_MAX_DELAY_MS=3000
SCENARIO_MAX_CONCURRENCY=5
SCENARIO_LARGE_VOLUME_COUNT=500

# Credenciales del servicio MinIO (solo al activarlo en docker-compose.yml).
# MINIO_ROOT_USER=CHANGE_ME_minio_root_user
# MINIO_ROOT_PASSWORD=CHANGE_ME_minio_root_password

# ── Etapa 4: trabajos asíncronos / exportaciones ─────────────────────────────
# Redis es SOLO la cola (BullMQ); PostgreSQL es la fuente de verdad del estado.
# `inline` procesa de forma síncrona y no necesita Redis (recomendado en CI/e2e).
REDIS_URL=redis://redis:6379
JOBS_QUEUE_MODE=redis
# Las exportaciones finalizadas más antiguas se purgan al arrancar el worker.
JOBS_RETENTION_HOURS=24
