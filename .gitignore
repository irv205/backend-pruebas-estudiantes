# Dependencias y compilación
node_modules/
dist/
coverage/
.nyc_output/

# Variables de entorno reales (nunca versionar; usa .env.example como plantilla)
.env
.env.*
!.env.example

# Logs y sistema
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
.idea/
.vscode/

# Prisma (BD local; las MIGRACIONES sí se versionan)
prisma/*.db

# Backups sueltos (SQL, archivos y volúmenes exportados). NO ignorar
# prisma/migrations/**/*.sql: esas migraciones forman parte del código.
*.sql
*.tgz
*.tar.gz
*.pem
*.key
*.p12
*.pfx
backups/
!prisma/migrations/**/*.sql

# Subidas en tiempo de ejecución (almacenamiento local de archivos)
storage/uploads/*

# URL pública efímera del túnel de Cloudflare (local, nunca versionada)
/run/
