# Normalización de fin de línea: los scripts NUNCA deben llegar a Windows con CRLF.
* text=auto

*.sh text eol=lf
*.bash text eol=lf
# Scripts nativos de Windows: CRLF en el checkout (cmd.exe y PowerShell lo aceptan).
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.env.example text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.ts text eol=lf
